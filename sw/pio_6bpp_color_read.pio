.program pio_6bpp_color_read
.wrap_target
    ;irq clear 0
    
    ;set pins 1 ; drain cap to gnd
    
    ; This reads one horizontal line of pixels only
entry_point:
    mov x y ;[31]   ; get "y" pixels also delay about another 2 px for some reason

    wait 1 irq 0 ;[4] ;wait for hsync signal on irq 0

    set pins 0 ; stop draining to gnd

    ;irq set 0 ; as soon as we get in, re-flag the irq

    ; we don't want to retrigger until the next hsync
;    set x 31 ; the first 44 pixels are junk
hblank: ; this looks weird but: 44px * 8 cycles pp = 352
;    jmp x-- hblank [11] ; 352 / 32 = 11 cycles per loop


skip_pixel_loop:
    irq set 1 [18]
    jmp x-- skip_pixel_loop

.wrap


;.program pio_6bpp_color_read_line
;.wrap_target
;    mov x y
;    
;    wait 1 irq 1
;
;pixelloop1:
;    irq set 2 [18] ; [23]       ;trigger a pixel read, wait for next pixel
;    jmp x-- pixelloop1
;
;.wrap



.program pio_6bpp_color_read_pixel
.side_set 3 ;opt
.wrap_target

    ;set pins 1 side 0b001 ; drain cap to gnd

    in y 23  side 0b001   

    wait 1 irq 1  side 0b001  
    
    ;set pins 0 [1] side 0b001 ; stop draining to gnd    
    ;nop [3]  side 0b001     ; 0b110 ; 0b001 channel 1
    ;nop [3]  side 0b001     ; 0b110 ; 0b001 channel 1

    ;Red
    in pins 3 [0]  side 0b010  
    ;settle
    nop [3]  side 0b010    ; 0b101 ; 0b010 channel 2  
    nop [3]  side 0b010    ; 0b101 ; 0b010 channel 2  
    ;nop [0]  side 0b010    ; 0b101 ; 0b010 channel 2 
    ;nop [0]  side 0b010    ; 0b101 ; 0b010 channel 2   


    ;Green
    in pins 3 [0]  side 0b100 
    ;settle
    nop [3]   side 0b100    ; 0b011 ; 0b100 channel 3 
    nop [3]   side 0b100    ; 0b011 ; 0b100 channel 3 
    ;nop [0]   side 0b100    ; 0b011 ; 0b100 channel 3 
    ;nop [0]   side 0b100    ; 0b011 ; 0b100 channel 3 


    ;Blue
    in pins 3 [0]  side 0b001 


.wrap






; genesis master clock is 53.693175MHz
; the genesis produces pixels at a  M/8 (6.712MHz) rate in H40 mode
; 0.14899 uS per pixel (148.99ns)
; this means the 420 pixels get blasted out in ~62.6us.
; thus
; we get about 8325.6 clock cycles at full speed for 420 pixels
; or about 19.823 clocks per pixel.
;
; we'll try the naive clock_get_hz(clk_sys) / 53693175
; if jitter is a problem
; we should use a faster clock so we can nudge data


%c-sdk {
