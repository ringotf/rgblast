.define vclk_gpio 25
.define csync_gpio 27

; This reads one horizontal line of pixels only
.program pio_8bit_color_read
.side_set 1 opt
.wrap_target
    ;irq clear 0
    
    mov x y ;[31]   ; get "y" pixels also delay about another 2 px for some reason

    wait 1 irq 0 [0]  ;wait for hsync signal on irq 0


    ;irq set 0 ; as soon as we get in, re-flag the irq

    ; we don't want to retrigger until the next hsync
;    set x 31 ; the first 44 pixels are junk
hblank: ; this looks weird but: 44px * 8 cycles pp = 352
;    jmp x-- hblank [11] ; 352 / 32 = 11 cycles per loop

    ;wait 0 gpio vclk_gpio 
    ;wait 1 gpio vclk_gpio 



pixelloop1:

;trigger a pixel read, wait for next pixel
    ;irq set 1  [31] ; [18]       


    irq set 2 [3] side 0b1;switch rgbmux to red
    ;nop [0]   ; clock the adc on

;Red?
    in pins 5  side 0b0 ;clear adc clk  
    ;in null 5  side 0b0 ;clear adc clk  

    irq set 2 [3] side 0b1;switch rgbmux to Green
    ;nop [0]   ; clock the adc on

;Green?
    in pins 5  side 0b0 ;clear adc clk  
    ;in null 5  side 0b0 ;clear adc clk  

    irq set 2 [3] side 0b1 ;switch rgbmux to Blue    
    ;nop [0]   ; clock the adc on

;Blue?
    in pins 5  side 0b0 ;clear adc clk
    ;in null 5 [0] side 0b0 ;clear adc clk
 
    ;irq set 2 [0] ; disable rgbmux
    ;nop [7]

    jmp x-- pixelloop1 [0] ; wait for next pixel
.wrap


;
; Reads individual pixels
;
.program pio_8bit_color_read_pixel
;.side_set 3 opt
.wrap_target

    ;in y 23  side 0b001    ;  0b110 ; 0b001 channel 1

    wait 1 irq 1  ;side 0b001 ;  0b110 ; 0b001 channel 1
    ;in pins 9  ; 8bit adc
    
    set pins 1 [1] 

    set pins 0 [1]
;Red
    in pins 4 [1] ;side 0b010    ; 0b101 ; 0b010 channel 2   

    ;in null 4 [1] ;side 0b010    ; 0b101 ; 0b010 channel 2   

    irq set 2 ;switch rgbmux to green
    
    ;settle
    ;nop [1]
    ;nop [1]

    set pins 1 [1]
    set pins 0

;Green
    ;in pins 4 [1] side 0b100    ; 0b011 ; 0b100 channel 3
    ;in null 1   
    in null 4 [1] ;side 0b100    ; 0b011 ; 0b100 channel 3

    irq set 2 ;switch rgbmux to blue

    ;settle
    ;nop [1]
    ;nop [1]
 
    set pins 1 [1]
    set pins 0
;Blue
    ;in pins 4 side 0b001     ; 0b110 ; 0b001 channel 1
    in null 4 ;side 0b001     ; 0b110 ; 0b001 channel 1

    irq set 2 ;switch rgbmux to red

    ;Red
    ;in pins 3 [1] side 0b010    ; 0b101 ; 0b010 channel 2 

    ;settle
    ;nop [1]
    ;nop [1]
    ;nop [1]
    ;nop [1] ;extra timing if needed
    ;;nop [1] ;extra timing if needed

    ;Green
    ;in pins 3 [1] side 0b100    ; 0b011 ; 0b100 channel 3 

    ;settle
    ;nop [1]
    ;nop [1]
    ;nop [1]
    ;nop [1] ;extra timing if needed
    ;;nop [1] ;extra timing if needed
    ;;nop [1] ;extra timing if needed

    ;Blue
    ;in pins 3  side 0b001     ; 0b110 ; 0b001 channel 1

.wrap


.program pio_rgbmux_switcher
.side_set 3
.wrap_target

    wait 1 irq 2 side 0b001    ; 0b110 ; 0b001 channel 1 (Red)  ;?????
    wait 1 irq 2 side 0b010    ; 0b101 ; 0b010 channel 2 (Green) ;????
    wait 1 irq 2 side 0b100    ; 0b011 ; 0b100 channel 3 (Blue) ;????

.wrap